@startuml
' Use-case diagram for Ekte Mat Online (INFO212 Oblig 4)
left to right direction
skinparam packageStyle rectangle

actor "Customer" as Customer
actor "Ekte Mat staff" as Staff

rectangle "Ekte Mat Online" {
    usecase "View menu by event" as C1
    usecase "Manage shopping cart" as C2
    usecase "Register / log in" as Login
    usecase "Submit an order" as C3
    usecase "View my orders" as C4
    usecase "Ask questions / read answers" as C5

    usecase "Manage food items" as A1
    usecase "Manage food images" as A2
    usecase "Manage orders and statuses" as A3
    usecase "Read / answer questions" as A4
}

Customer -- C1
Customer -- C2
Customer -- Login
Customer -- C3
Customer -- C4
Customer -- C5

Staff -- A1
Staff -- A2
Staff -- A3
Staff -- A4

@enduml

